# Required for canonical URLs in later phases
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Riverside Community Credit Union

# Phase 3 — forms (Resend). Forms validate without these, but email delivery
# requires all three. Get a key at https://resend.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
NOTIFICATION_TO_EMAIL=

